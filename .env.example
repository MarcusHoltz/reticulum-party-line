# Reticulum Party Line - environment overrides
# Copy this to .env and uncomment the lines you need.
# docker compose run --rm shell reads this automatically.

# ---- Audio ----
#
# Native runs prefer the system sound server (parecord/paplay, PulseAudio or
# PipeWire) and follow your desktop's default mic/speakers. No settings needed
# for most setups. Pick a specific device in-app via Settings, Audio devices.
#
# Setting ALSA_DEVICE or ALSA_PLAY_DEVICE below FORCES the ALSA-direct backend
# (bypassing the sound server). Use this for Docker, headless/daemon setups, or
# bare-ALSA systems. Docker mounts the host PulseAudio socket, with ALSA direct
# as fallback.
#
# To find your device numbers, run on the HOST (not inside Docker):
#   arecord -l    - lists capture devices (microphones)
#   aplay -l      - lists playback devices (speakers)
#
# Use plughw (recommended) to allow automatic format conversion, or hw for
# exact hardware access (may require matching sample rate/format).

# Capture device (microphone) - blank = sound-server default; set = force ALSA
#ALSA_DEVICE=plughw:2,0

# Playback device (speakers) - blank = sound-server default / same card as capture
#ALSA_PLAY_DEVICE=plughw:0,0

# PipeWire/PulseAudio capture device name - blank = system default
#PULSE_SOURCE=

# PipeWire/PulseAudio playback device name - blank = system default
#PULSE_SINK=

# ---- Docker audio: PulseAudio/PipeWire socket ----
#
# In Docker mode, audio routes through the host user's PipeWire session via the
# PulseAudio-compatible socket at /run/user/<UID>/pulse/native.
#
# If your user ID is not 1000, set this before running docker compose:
#   export XDG_RUNTIME_DIR=/run/user/$(id -u)
# Or uncomment and set it here:
#UID=1000

# ---- Reticulum transport ----

# Reflector listen port (loopback, inside the compose network)
#REFLECTOR_PORT=4242

# RNS listen address
#RNS_LISTEN_HOST=0.0.0.0

# ---- Call settings ----
#
# NOTE: the SHARED SECRET is deliberately NOT set here. Environment variables
# can leak (via `docker inspect`, `/proc/<pid>/environ`, container logs), so
# the secret is a bind-mounted file instead. Put it in secrets/shared_secret.txt
# (the secrets/ dir is bind-mounted read-only into the container; see
# docker-compose.yml).

# Opus bitrate in kbps (default: 16; raise to 24-32 for better quality)
#OPUS_BITRATE=16

# OpenSSL cipher (default: aes-256-cbc)
#CIPHER=aes-256-cbc

# HMAC-sign all protocol messages (0 = off, 1 = on; default: 1)
#HMAC_AUTH=1

# Auto-listen once RNS is ready (0/1; default: 0)
#AUTO_LISTEN=0

# PTT chime notification (off, tone, double, chirp, ding; default: off)
# Plays a short tone when the remote party starts recording.
#PTT_CHIME=off

# Normalize received audio so all callers play at the same volume.
# flag: --normalize/--no-normalize (0 = off, 1 = on; default: 0)
#NORMALIZE_PLAYBACK=0

# Full-duplex: live bidirectional audio (both parties talk simultaneously).
# Requires TCP-class transport (backbone hubs or LAN). LoRa and packet radio
# cannot sustain the bandwidth and will not work.
# flag: --full-duplex/--no-full-duplex (0 = PTT, 1 = full-duplex; default: 0)
#FULL_DUPLEX=0

# ---- Liveness / keep-alive tuning ----
#
# RELAY_IDLE_TIMEOUT: relay drops a caller after this many seconds of silence.
#   Must be > MAX_PTT_SECONDS + HEARTBEAT_INTERVAL + ~20s. Default: 240.
# HEARTBEAT_INTERVAL: PING interval in seconds. Default: 20.
# CLIENT_TIMEOUT: no inbound traffic for this many seconds = dropped. Default: 180.
# RECONNECT_ATTEMPTS: auto-reconnect tries after a drop. Default: 3.
#RELAY_IDLE_TIMEOUT=240
#HEARTBEAT_INTERVAL=20
#CLIENT_TIMEOUT=180
#RECONNECT_ATTEMPTS=3

# ---- Anti-flood / DoS limits ----
#
# MAX_PTT_SECONDS: hard cap on a single PTT transmission. Default: 120.
# MAX_LINE_BYTES: relay drops lines larger than this. Default: 524288.
# RELAY_MAX_MSG_PER_SEC: per-caller message rate limit. Default: 15.
# RELAY_MAX_INFLIGHT: max background FIFO-forward writes per caller. Default: 64.
# RELAY_WRITE_TIMEOUT: abandon a stalled write after this many seconds. Default: 30.
# DECRYPT_TIMEOUT: kill a stalled decrypt after this many seconds. Default: 10.
# PTT_CHUNK_SECONDS: split PTT into chunks of this size. Default: 10.
#MAX_PTT_SECONDS=120
#MAX_LINE_BYTES=524288
#RELAY_MAX_MSG_PER_SEC=15
#RELAY_MAX_INFLIGHT=64
#RELAY_WRITE_TIMEOUT=30
#DECRYPT_TIMEOUT=10
#PTT_CHUNK_SECONDS=10
