# ---- Version control ----
.git/
.gitignore
.gitattributes

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- CI/CD (not needed inside the image) ----
.github/
.gitlab-ci.yml
docker/hooks/

# ---- Docker / compose files (not needed inside the image) ----
docker-compose.yml
docker-compose.override.yml
docker-compose*.yml
.env.example

# ---- Secrets: never sent to Docker build context ----
secrets/
.env
.env.*
*.env

# ---- Scratch bridge extract (runtime only, not source) ----
rns_bridge.py

# ---- Project runtime data (created at container run time, not build time) ----
data/

# ---- Docs / misc (not needed in image) ----
README*
README-hub.md
LICENSE
*.md

# ---- OS artifacts ----
.DS_Store
Thumbs.db

